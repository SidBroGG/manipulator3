<?xml version="1.0"?>
<!-- Cleaned & normalized URDF for 6-DOF Manipulator with Gripper -->
<robot name="root">
    <mujoco>
        <compiler discardvisual="false"/>
    </mujoco>

    <material name="petg_grey">
        <color rgba="0.65 0.65 0.65 1.0"/>
    </material>

    <link name="base_link">
        <inertial>
            <mass value="0.140"/>
            <origin xyz="-0.000327 0.000476 -0.036632" rpy="0 0 0"/>
            <inertia ixx="3.535e-04" ixy="-2.190e-08" ixz="-5.529e-07" iyy="3.486e-04" iyz="-2.700e-06" izz="5.066e-04"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="meshes/base_stand.stl" scale="1 1 1"/>
            </geometry>
            <material name="petg_grey"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="meshes/base_stand.stl" scale="1 1 1"/>
            </geometry>
        </collision>
    </link>

    <link name="base_spinning">
        <inertial>
            <mass value="0.135"/>
            <origin xyz="-6.781e-05 -1.190e-05 0.02308" rpy="0 0 0"/>
            <inertia ixx="2.179e-04" ixy="-1.657e-08" ixz="1.012e-07" iyy="1.077e-04" iyz="1.751e-08" izz="2.226e-04"/>
        </inertial>
        <visual>
            <origin xyz="-3.236e-48 6.8544e-17 -0.014" rpy="0 0 0"/>
            <geometry>
                <mesh filename="meshes/base_spinning.stl" scale="1 1 1"/>
            </geometry>
            <material name="petg_grey"/>
        </visual>
        <collision>
            <origin xyz="-3.236e-48 6.8544e-17 -0.014" rpy="0 0 0"/>
            <geometry>
                <mesh filename="meshes/base_spinning.stl" scale="1 1 1"/>
            </geometry>
        </collision>
    </link>

    <link name="shoulder_link">
        <inertial>
            <mass value="0.132"/>
            <origin xyz="0.000148 -0.001283 0.065867" rpy="0 0 0"/>
            <inertia ixx="3.123e-04" ixy="3.778e-07" ixz="2.745e-07" iyy="2.899e-04" iyz="-5.001e-05" izz="9.814e-05"/>
        </inertial>
        <visual>
            <origin xyz="0.0002 -0.010669 -0.057969" rpy="0 0 0"/>
            <geometry>
                <mesh filename="meshes/shoulder.stl" scale="1 1 1"/>
            </geometry>
            <material name="petg_grey"/>
        </visual>
        <collision>
            <origin xyz="0.0002 -0.010669 -0.057969" rpy="0 0 0"/>
            <geometry>
                <mesh filename="meshes/shoulder.stl" scale="1 1 1"/>
            </geometry>
        </collision>
    </link>

    <link name="elbow_link">
        <inertial>
            <mass value="0.110"/>
            <origin xyz="0.00018 -0.010554 0.060288" rpy="0 0 0"/>
            <inertia ixx="2.545e-04" ixy="2.612e-07" ixz="1.503e-07" iyy="2.469e-04" iyz="8.716e-07" izz="7.951e-05"/>
        </inertial>
        <visual>
            <origin xyz="0.0002 -0.010669 -0.174969" rpy="0 0 0"/>
            <geometry>
                <mesh filename="meshes/elbow.stl" scale="1 1 1"/>
            </geometry>
            <material name="petg_grey"/>
        </visual>
        <collision>
            <origin xyz="0.0002 -0.010669 -0.174969" rpy="0 0 0"/>
            <geometry>
                <mesh filename="meshes/elbow.stl" scale="1 1 1"/>
            </geometry>
        </collision>
    </link>

    <link name="wrist_link">
        <inertial>
            <mass value="0.065"/>
            <origin xyz="0.005936 0.010174 0.029235" rpy="0 0 0"/>
            <inertia ixx="5.635e-05" ixy="-5.063e-08" ixz="-1.376e-05" iyy="9.347e-05" iyz="-1.846e-07" izz="4.503e-05"/>
        </inertial>
        <visual>
            <origin xyz="-0.000223271 0.0100928 -0.289483" rpy="0 0 0"/>
            <geometry>
                <mesh filename="meshes/wrist.stl" scale="1 1 1"/>
            </geometry>
            <material name="petg_grey"/>
        </visual>
        <collision>
            <origin xyz="-0.000223271 0.0100928 -0.289483" rpy="0 0 0"/>
            <geometry>
                <mesh filename="meshes/wrist.stl" scale="1 1 1"/>
            </geometry>
        </collision>
    </link>

    <link name="main__gripperbase">
        <inertial>
            <mass value="0.086"/>
            <origin xyz="-0.002452 0.001003 0.016331" rpy="0 0 0"/>
            <inertia ixx="2.269e-05" ixy="-2.355e-08" ixz="3.213e-06" iyy="1.752e-05" iyz="-6.609e-08" izz="1.099e-05"/>
        </inertial>
        <visual>
            <origin xyz="0.013 0 -0.3665" rpy="0 0 0"/>
            <geometry>
                <mesh filename="meshes/gripper_base.stl" scale="1 1 1"/>
            </geometry>
            <material name="petg_grey"/>
        </visual>
        <collision>
            <origin xyz="0.013 0 -0.3665" rpy="0 0 0"/>
            <geometry>
                <mesh filename="meshes/gripper_base.stl" scale="1 1 1"/>
            </geometry>
        </collision>
    </link>

    <link name="main__gripper1">
        <inertial>
            <mass value="0.015"/>
            <origin xyz="0.002617 0.019424 0.04507" rpy="0 0 0"/>
            <inertia ixx="8.626e-06" ixy="-7.256e-09" ixz="-1.773e-08" iyy="7.521e-06" iyz="-2.632e-06" izz="1.233e-06"/>
        </inertial>
        <visual>
            <origin xyz="0.0171294 -0.00955012 -0.402" rpy="0 0 0"/>
            <geometry>
                <mesh filename="meshes/gripper_finger1.stl" scale="1 1 1"/>
            </geometry>
            <material name="petg_grey"/>
        </visual>
        <collision>
            <origin xyz="0.0171294 -0.00955012 -0.402" rpy="0 0 0"/>
            <geometry>
                <mesh filename="meshes/gripper_finger1.stl" scale="1 1 1"/>
            </geometry>
        </collision>
    </link>

    <link name="main__gripper2">
        <inertial>
            <mass value="0.015"/>
            <origin xyz="0.002219 -0.021419 0.039798" rpy="0 0 0"/>
            <inertia ixx="1.098e-05" ixy="-8.521e-09" ixz="1.885e-08" iyy="9.470e-06" iyz="3.387e-06" izz="1.646e-06"/>
        </inertial>
        <visual>
            <origin xyz="0.0170823 0.00745048 -0.402" rpy="0 0 0"/>
            <geometry>
                <mesh filename="meshes/gripper_finger2.stl" scale="1 1 1"/>
            </geometry>
            <material name="petg_grey"/>
        </visual>
        <collision>
            <origin xyz="0.0170823 0.00745048 -0.402" rpy="0 0 0"/>
            <geometry>
                <mesh filename="meshes/gripper_finger2.stl" scale="1 1 1"/>
            </geometry>
        </collision>
    </link>

    <joint name="revolute_1" type="revolute">
        <origin xyz="0 0 0.013" rpy="0 0 0"/>
        <axis xyz="0 0 -1"/>
        <limit lower="-3.14159" upper="3.14159" effort="1.5" velocity="3.0"/>
        <parent link="base_link"/>
        <child link="base_spinning"/>
    </joint>

    <joint name="revolute_2" type="revolute">
        <origin xyz="-0.00153435 0.010669 0.043598" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-1.5708" upper="1.5708" effort="2.5" velocity="3.0"/>
        <parent link="base_spinning"/>
        <child link="shoulder_link"/>
    </joint>

    <joint name="revolute_3" type="revolute">
        <origin xyz="0 0 0.117" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-1.5708" upper="1.5708" effort="2.0" velocity="3.0"/>
        <parent link="shoulder_link"/>
        <child link="elbow_link"/>
    </joint>

    <joint name="revolute_4" type="revolute">
        <origin xyz="-7.67294e-05 -0.0207719 0.117514" rpy="0 0 0"/>
        <axis xyz="0 -1 0"/>
        <limit lower="-1.5708" upper="1.5708" effort="1.5" velocity="3.0"/>
        <parent link="elbow_link"/>
        <child link="wrist_link"/>
    </joint>

    <joint name="revolute_5" type="revolute">
        <origin xyz="-0.0127233 0.0100928 0.0740668" rpy="0 0 0"/>
        <axis xyz="0 0 -1"/>
        <limit lower="-1.5708" upper="1.5708" effort="1.0" velocity="3.0"/>
        <parent link="wrist_link"/>
        <child link="main__gripperbase"/>
    </joint>

    <joint name="revolute_6" type="revolute">
        <origin xyz="-0.0042323 -0.00744957 0.0355" rpy="0 0 0"/>
        <axis xyz="-1 0 0"/>
        <limit lower="-0.6" upper="0.6" effort="1.0" velocity="3.0"/>
        <mimic joint="revolute_7" multiplier="-1.0" offset="0.0"/>
        <parent link="main__gripperbase"/>
        <child link="main__gripper2"/>
    </joint>

    <joint name="revolute_7" type="revolute">
        <origin xyz="-0.0041294 0.00955012 0.0355" rpy="0 0 0"/>
        <axis xyz="-1 0 0"/>
        <limit lower="-0.6" upper="0.6" effort="1.0" velocity="3.0"/>
        <parent link="main__gripperbase"/>
        <child link="main__gripper1"/>
    </joint>
</robot>

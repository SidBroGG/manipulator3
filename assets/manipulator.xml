<mujoco model="manipulator3">
  <compiler angle="radian" meshdir="meshes" autolimits="true"/>

  <option gravity="0 0 -9.81" timestep="0.002"/>

  <default>
    <joint damping="0.1" armature="0.01"/>
    <default class="visual">
      <geom group="1" type="mesh" contype="0" conaffinity="0" density="1050" rgba="0.65 0.65 0.65 1.0"/>
    </default>
    <default class="collision">
      <geom group="0" type="mesh" contype="1" conaffinity="1" density="1050" rgba="0.8 0.2 0.2 0.0" friction="1.0 0.05 0.001"/>
    </default>
    <default class="gripper_finger">
      <geom group="0" type="mesh" contype="1" conaffinity="1" density="1050" rgba="0.65 0.65 0.65 1.0" friction="1.5 0.05 0.001"/>
    </default>
  </default>

  <asset>
    <mesh name="base_stand" file="base_stand.stl"/>
    <mesh name="base_spinning" file="base_spinning.stl"/>
    <mesh name="shoulder" file="shoulder.stl"/>
    <mesh name="elbow" file="elbow.stl"/>
    <mesh name="wrist" file="wrist.stl"/>
    <mesh name="gripper_base" file="gripper_base.stl"/>
    <mesh name="gripper_finger1" file="gripper_finger1.stl"/>
    <mesh name="gripper_finger2" file="gripper_finger2.stl"/>
  </asset>

  <worldbody>
    <body name="base_link" pos="0 0 0.066536" euler="0 0 3.14159265">
      <geom class="visual" mesh="base_stand"/>
      <geom class="collision" mesh="base_stand"/>

      <body name="base_spinning" pos="0 0 0.013">
        <joint name="revolute_1" type="hinge" axis="0 0 -1" range="-3.14159 3.14159"/>
        <geom class="visual" mesh="base_spinning" pos="-3.236e-48 6.8544e-17 -0.014"/>
        <geom class="collision" mesh="base_spinning" pos="-3.236e-48 6.8544e-17 -0.014"/>

        <body name="shoulder_link" pos="-0.00153435 0.010669 0.043598">
          <joint name="revolute_2" type="hinge" axis="0 1 0" range="-1.5708 1.5708"/>
          <geom class="visual" mesh="shoulder" pos="0.0002 -0.010669 -0.057969"/>
          <geom class="collision" mesh="shoulder" pos="0.0002 -0.010669 -0.057969"/>

          <body name="elbow_link" pos="0 0 0.117">
            <joint name="revolute_3" type="hinge" axis="0 1 0" range="-1.5708 1.5708"/>
            <geom class="visual" mesh="elbow" pos="0.0002 -0.010669 -0.174969"/>
            <geom class="collision" mesh="elbow" pos="0.0002 -0.010669 -0.174969"/>

            <body name="wrist_link" pos="-7.67294e-05 -0.0207719 0.117514">
              <joint name="revolute_4" type="hinge" axis="0 -1 0" range="-1.5708 1.5708"/>
              <geom class="visual" mesh="wrist" pos="-0.000223271 0.0100928 -0.289483"/>
              <geom class="collision" mesh="wrist" pos="-0.000223271 0.0100928 -0.289483"/>

              <body name="main__gripperbase" pos="-0.0127233 0.0100928 0.0740668">
                <joint name="revolute_5" type="hinge" axis="0 0 -1" range="-1.5708 1.5708"/>
                <geom class="visual" mesh="gripper_base" pos="0.013 0 -0.3665"/>
                <geom class="collision" mesh="gripper_base" pos="0.013 0 -0.3665"/>

                <!-- OV5647 Camera (62.2 deg horizontal FOV, mounted on top of gripper) -->
                <camera name="gripper_camera" pos="0 0 0.048" xyaxes="0 -1 0 -1 0 0" fovy="48.8"/>


                <!-- VL53L0X ToF rangefinder site (pointing +Z along gripper approach axis) -->
                <site name="tof_site" pos="0 0 0.048" size="0.004" rgba="1 0 0 0.8"/>

                <!-- Gripper jaw 2 (mimicked) -->
                <body name="main__gripper2" pos="-0.0042323 -0.00744957 0.0355">
                  <joint name="revolute_6" type="hinge" axis="-1 0 0" range="-0.6 0.15"/>
                  <geom class="gripper_finger" mesh="gripper_finger2" pos="0.0170823 0.00745048 -0.402"/>
                </body>

                <!-- Gripper jaw 1 (actuated) -->
                <body name="main__gripper1" pos="-0.0041294 0.00955012 0.0355">
                  <joint name="revolute_7" type="hinge" axis="-1 0 0" range="-0.15 0.6"/>
                  <geom class="gripper_finger" mesh="gripper_finger1" pos="0.0171294 -0.00955012 -0.402"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <equality>
    <joint joint1="revolute_6" joint2="revolute_7" polycoef="0 -1 0 0 0"/>
  </equality>

  <actuator>
    <position name="act_revolute_1" joint="revolute_1" kp="20" kv="1" ctrlrange="-3.14159 3.14159"/>
    <position name="act_revolute_2" joint="revolute_2" kp="30" kv="2" ctrlrange="-1.5708 1.5708"/>
    <position name="act_revolute_3" joint="revolute_3" kp="25" kv="1.5" ctrlrange="-1.5708 1.5708"/>
    <position name="act_revolute_4" joint="revolute_4" kp="15" kv="1" ctrlrange="-1.5708 1.5708"/>
    <position name="act_revolute_5" joint="revolute_5" kp="10" kv="0.5" ctrlrange="-1.5708 1.5708"/>
    <position name="act_gripper" joint="revolute_7" kp="15" kv="1" ctrlrange="-0.15 0.6"/>
  </actuator>

  <sensor>
    <rangefinder name="tof_rangefinder" site="tof_site" cutoff="2.0"/>
  </sensor>

  <contact>
    <exclude body1="base_link" body2="base_spinning"/>
  </contact>
</mujoco>
